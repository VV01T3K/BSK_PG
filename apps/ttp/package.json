{
  "name": "ttp",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test --pass-with-no-tests --timeout 20000",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@bsk/crypto": "workspace:*",
    "@bsk/rpc": "workspace:*",
    "@orpc/server": "1.14.5",
    "node-forge": "1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node-forge": "1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260605.1"
  }
}
