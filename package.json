{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --workspaces --if-present --parallel dev",
    "build": "bun run --workspaces --if-present --sequential build",
    "test": "bun run --workspaces --if-present --sequential test",
    "typecheck": "bun run --workspaces --if-present --sequential typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "ready": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0"
  },
  "packageManager": "bun@1.3.12"
}
