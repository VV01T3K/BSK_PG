{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --workspaces --if-present --parallel dev",
    "build": "bun run --workspaces --if-present --sequential build",
    "test": "bun run --workspaces --if-present --sequential test",
    "check": "oxfmt --check && oxlint && bun run --workspaces --if-present --sequential typecheck",
    "fix": "oxfmt --write && oxlint --fix",
    "docs:doxygen": "mkdir -p docs/generated/doxygen && doxygen Doxyfile",
    "docs:pdf": "bun run docs:doxygen && make -C docs/generated/doxygen/latex && mv docs/generated/doxygen/latex/refman.pdf docs/doxygen_docs.pdf"
  },
  "devDependencies": {
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0"
  },
  "packageManager": "bun@1.3.14"
}
