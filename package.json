{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --workspaces --if-present --parallel dev",
    "build": "bun run --workspaces --if-present --sequential build",
    "test": "bun run --workspaces --if-present --sequential test",
    "typecheck": "bun run --workspaces --if-present --sequential typecheck",
    "ready": "bun run typecheck && bun run test && bun run build"
  },
  "packageManager": "bun@1.3.12"
}
